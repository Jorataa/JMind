# ─────────────────────────────────────────────────────────────
# Jorata — example environment file (safe to commit to GitHub)
# Copy this file to `.env.local` and fill in your real values.
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# Google Gemini API key — powers the AI Chat feature.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────
# Visitor log → Google Sheet (optional). See SETUP-VISITOR-LOG.md.
# The /exec URL of your Apps Script Web App. If unset, the name gate
# still works but nothing is written to the sheet.
GSHEET_WEBHOOK_URL=
# Shared secret. Must match the SECRET in your Apps Script (recommended).
GSHEET_TOKEN=

# ─────────────────────────────────────────────────────────────
# Cloud Sync (OPTIONAL) — Supabase auth + Postgres. See SETUP.md.
# Leave BOTH blank to keep Jorata 100% local-first: no sign-in UI
# appears and nothing ever leaves the device. Fill BOTH in to offer
# opt-in, email-based sync across devices.
#
# These are exposed to the browser (NEXT_PUBLIC_*). That is expected:
# the anon key is a PUBLIC key — your data is protected by Row-Level
# Security policies, NOT by hiding this key. Never put the Supabase
# service_role key here or anywhere client-side.
#
# Find both at: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
